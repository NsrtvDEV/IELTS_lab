PROJECT_NAME=BandUp
# 1 — разработка (документация API /docs, подробные ошибки); на сервере 0
DEBUG=0

DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# подписывает токены API. Случайная строка от 32 символов:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ── только для сервера (локально можно не задавать) ──
# свой ключ для Django-админки — другой, не SECRET_KEY
ADMIN_SECRET_KEY=
# адрес фронтенда: только с него браузеру можно обращаться к API
CORS_ORIGINS=["https://bandup.uz"]
# IP nginx — чтобы лимиты на вход считались по настоящему IP пользователя
TRUSTED_PROXIES=["127.0.0.1"]
# домен админки и её адрес для защиты форм (CSRF)
ADMIN_HOSTS=["admin.bandup.uz"]
ADMIN_CSRF_ORIGINS=["https://admin.bandup.uz"]

# ── письма: сброс пароля ──
# адрес сайта — из него строится ссылка в письме
FRONTEND_URL=https://bandup.uz
# SMTP почтового сервиса (Gmail с паролем приложения, Brevo, Mailgun, Yandex и т.п.).
# Без SMTP_HOST письма не отправляются, а при DEBUG=1 выводятся в лог сервера
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BandUp <no-reply@bandup.uz>
# true — порт 465 (SSL сразу); false — порт 587 со STARTTLS
SMTP_SSL=false
